{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "redirects": [
    {
      "source": "/parents",
      "destination": "https://lilbaby.vercel.app/",
      "permanent": true
    },
    {
      "source": "/parents/:path*",
      "destination": "https://lilbaby.vercel.app/:path*",
      "permanent": true
    }
  ]
}
