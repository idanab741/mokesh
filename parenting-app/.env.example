# Copy to .env and fill in. Only EXPO_PUBLIC_* variables are bundled into the app,
# so NEVER put a secret here (no service_role key, no database password).
#
# Leave both empty to run fully on-device (no accounts, no sync).

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable ("anon") key. Safe to ship: every table is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
